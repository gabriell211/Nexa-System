{
  "name": "nexa-app-mobile-tecnico",
  "version": "0.2.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "backend:smoke": "node scripts/verify-production-api.mjs",
    "postinstall": "node scripts/prepare-brand-assets.mjs",
    "brand:generate": "node scripts/prepare-brand-assets.mjs",
    "brand:check": "node scripts/verify-brand-assets.mjs",
    "routes:check": "node scripts/verify-routes.mjs",
    "bundle:android": "expo export --platform android --output-dir dist"
  },
  "dependencies": {
    "expo": "~54.0.0",
    "expo-secure-store": "~15.0.7",
    "react": "19.1.0",
    "react-native": "0.81.4",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-svg": "15.12.1",
    "react-native-view-shot": "4.0.3",
    "expo-splash-screen": "~31.0.10",
    "expo-router": "~6.0.24",
    "react-native-screens": "~4.16.0",
    "expo-linking": "~8.0.11",
    "expo-constants": "~18.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-crypto": "~15.0.9",
    "@tanstack/react-query": "^5.90.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2",
    "sharp": "0.34.5"
  },
  "allowScripts": {
    "sharp@0.34.5": true
  }
}
