{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nexa Collector",
  "version": "0.1.1",
  "identifier": "com.nexa.collector",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nexa Collector",
        "width": 1200,
        "height": 780,
        "minWidth": 860,
        "minHeight": 580,
        "backgroundColor": "#F5F7FB"
      }
    ],
    "security": {
      "capabilities": [
        "main-window"
      ],
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "externalBin": [
      "binaries/nexa-collector-daemon"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": [
          "PortugueseBR",
          "English"
        ],
        "displayLanguageSelector": false,
        "installerHooks": "./windows/installer-hooks.nsh",
        "startMenuFolder": "Nexa System"
      }
    },
    "category": "Utility",
    "shortDescription": "Agente local Nexa para monitoramento de impressoras",
    "linux": {
      "deb": {
        "files": {
          "/usr/lib/nexa-collector/nexa-collector-daemon": "binaries/nexa-collector-daemon-x86_64-unknown-linux-gnu",
          "/lib/systemd/system/nexa-collector.service": "../../linux/package/nexa-collector.service",
          "/usr/share/nexa-collector/config.example.json": "../../config.example.json"
        },
        "postInstallScript": "../../linux/package/postinstall.sh",
        "preRemoveScript": "../../linux/package/preremove.sh"
      },
      "rpm": {
        "files": {
          "/usr/lib/nexa-collector/nexa-collector-daemon": "binaries/nexa-collector-daemon-x86_64-unknown-linux-gnu",
          "/usr/lib/systemd/system/nexa-collector.service": "../../linux/package/nexa-collector.service",
          "/usr/share/nexa-collector/config.example.json": "../../config.example.json"
        },
        "postInstallScript": "../../linux/package/postinstall.sh",
        "preRemoveScript": "../../linux/package/preremove.sh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
