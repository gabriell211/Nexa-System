APP_NAME="Nexa System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=nexa
DB_USERNAME=nexa
DB_PASSWORD=change-this-local-password

CACHE_STORE=file
SESSION_DRIVER=file
SESSION_SECURE_COOKIE=false
SESSION_LIFETIME=120
NEXA_ALLOW_LEGACY_TOKEN_LOGIN=false
QUEUE_CONNECTION=sync
LOG_CHANNEL=stderr
SANCTUM_EXPIRATION=10080

NEXA_BOOTSTRAP_TENANT=nexa-demo
NEXA_BOOTSTRAP_NAME="Nexa Demo"
NEXA_BOOTSTRAP_EMAIL=
NEXA_BOOTSTRAP_PASSWORD=

# Disabled by default; these are missing-meter-sample alerts, NOT offline status.
NEXA_TELEMETRY_GAP_ENABLED=false
NEXA_TELEMETRY_GAP_MINUTES=60
NEXA_TELEMETRY_RECOVERY_MINUTES=10

# Agent heartbeat freshness window shown in backoffice (no automatic offline assertion).
NEXA_HEARTBEAT_MAX_SILENCE_SECONDS=180

# Explicit opt-in: configure a real, protected mail transport before activation.
NEXA_COLLECTOR_HEALTH_ALERTS_ENABLED=false
NEXA_COLLECTOR_HEALTH_SILENCE_SECONDS=300
NEXA_COLLECTOR_NOTIFICATIONS_ENABLED=false
NEXA_COLLECTOR_ESCALATION_MINUTES=60
# For development this LOGS email; it does not deliver messages.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=notifications@example.test
MAIL_FROM_NAME="Nexa System"

# Optional collector SMTP/POP3 path. Use a dedicated inbox and real outbound mailer.
# Keep these credentials in the deployment secret store, not in source control.
NEXA_COLLECTOR_MAIL_INBOX_ENABLED=false
NEXA_COLLECTOR_MAIL_INBOX_ADDRESS=
NEXA_COLLECTOR_MAIL_INBOX_PASSWORD=
NEXA_COLLECTOR_MAIL_POP3_HOST=
NEXA_COLLECTOR_MAIL_POP3_PORT=995
NEXA_COLLECTOR_MAIL_POP3_IMPLICIT_TLS=true

# Collector notification limits (the default remains disabled).
NEXA_COLLECTOR_MAIL_MAX_PER_RUN=50
NEXA_COLLECTOR_MAIL_MAX_PER_TENANT_HOUR=20
NEXA_COLLECTOR_MAIL_MAX_GLOBAL_HOUR=100

# Optional provider-correlated Resend delivery events (disabled by default).
# Only 'resend' driver captures Resend API UUIDs. Do NOT commit keys/secrets.
NEXA_COLLECTOR_MAIL_DRIVER=laravel
NEXA_RESEND_API_KEY=
NEXA_RESEND_WEBHOOKS_ENABLED=false
NEXA_RESEND_WEBHOOK_SECRET=

# Signed early webhook backlog: bounded sweep and 72-hour uncorrelated retention.
NEXA_RESEND_RECONCILE_BATCH=100
NEXA_RESEND_PENDING_HOURS=72

# Optional CLI/monitoring-only health check; never returns per-customer details.
NEXA_RESEND_MONITOR_ENABLED=false
NEXA_RESEND_WARN_UNKNOWN_MINUTES=15
NEXA_RESEND_CRITICAL_KNOWN_MINUTES=2
NEXA_RESEND_CRITICAL_PENDING_COUNT=100
