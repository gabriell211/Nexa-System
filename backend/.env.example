APP_NAME="Nexa System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=nexa
DB_USERNAME=nexa
DB_PASSWORD=change-this-local-password

CACHE_STORE=file
SESSION_DRIVER=file
SESSION_SECURE_COOKIE=false
SESSION_LIFETIME=120
NEXA_ALLOW_LEGACY_TOKEN_LOGIN=false
QUEUE_CONNECTION=sync
LOG_CHANNEL=stderr
SANCTUM_EXPIRATION=10080

NEXA_BOOTSTRAP_TENANT=nexa-demo
NEXA_BOOTSTRAP_NAME="Nexa Demo"
NEXA_BOOTSTRAP_EMAIL=
NEXA_BOOTSTRAP_PASSWORD=

# Disabled by default; these are missing-meter-sample alerts, NOT offline status.
NEXA_TELEMETRY_GAP_ENABLED=false
NEXA_TELEMETRY_GAP_MINUTES=60
NEXA_TELEMETRY_RECOVERY_MINUTES=10
