APP_NAME="Nexa System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=nexa
DB_USERNAME=nexa
DB_PASSWORD=change-this-local-password

CACHE_STORE=file
SESSION_DRIVER=file
SESSION_SECURE_COOKIE=false
SESSION_LIFETIME=120
NEXA_ALLOW_LEGACY_TOKEN_LOGIN=false
QUEUE_CONNECTION=sync
LOG_CHANNEL=stderr
SANCTUM_EXPIRATION=10080

NEXA_BOOTSTRAP_TENANT=nexa-demo
NEXA_BOOTSTRAP_NAME="Nexa Demo"
NEXA_BOOTSTRAP_EMAIL=
NEXA_BOOTSTRAP_PASSWORD=

# Disabled by default; these are missing-meter-sample alerts, NOT offline status.
NEXA_TELEMETRY_GAP_ENABLED=false
NEXA_TELEMETRY_GAP_MINUTES=60
NEXA_TELEMETRY_RECOVERY_MINUTES=10

# Agent heartbeat freshness window shown in backoffice (no automatic offline assertion).
NEXA_HEARTBEAT_MAX_SILENCE_SECONDS=180

# Explicit opt-in: configure a real, protected mail transport before activation.
NEXA_COLLECTOR_HEALTH_ALERTS_ENABLED=false
NEXA_COLLECTOR_HEALTH_SILENCE_SECONDS=300
NEXA_COLLECTOR_NOTIFICATIONS_ENABLED=false
NEXA_COLLECTOR_ESCALATION_MINUTES=60
# For development this LOGS email; it does not deliver messages.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=notifications@example.test
MAIL_FROM_NAME="Nexa System"
